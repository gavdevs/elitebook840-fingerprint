# Stub package that satisfies both `pacman -Q libfprint-git` (what Omarchy's
# omarchy-pkg-missing checks) and any dependency on the name libfprint-git,
# while the actual library comes from libfprint-tod.
#
# Why a stub and not `provides=`: pacman -Q does not resolve provides, only
# real package names, so omarchy-pkg-missing still reports libfprint-git
# missing and then tries to install the omarchy repo build, which conflicts
# with libfprint-tod.
#
# The version is deliberately higher than the omarchy repo's
# 1:1.94.100.r10.g6f9479c-5 so a system upgrade does not try to "upgrade"
# this stub back into the conflicting real package.
pkgname=libfprint-git
pkgver=1.95.2+tod1
pkgrel=1
epoch=1
pkgdesc="Stub: libfprint supplied by libfprint-tod (keeps Omarchy dependency checks satisfied)"
arch=(x86_64)
license=(none)
depends=(libfprint-tod)
options=(!strip)
package() {
  install -dm755 "$pkgdir/usr/share/doc/libfprint-git"
  cat > "$pkgdir/usr/share/doc/libfprint-git/README" <<'TXT'
libfprint is provided by libfprint-tod on this system.

This package exists only so that `pacman -Q libfprint-git` succeeds: Omarchy's
fingerprint setup checks that exact package name (pacman -Q does not resolve
provides), and installing the real libfprint-git conflicts with libfprint-tod.
TXT
}
