+    random_calls++;
+    if(fail_random) return 0;
+    for(size_t i = 0; i < len; i++) buf[i] = (unsigned char) i;
+    return 1;
+}
+
+typedef BOOL (__winfnc *acquire_a_fnc)(struct crypt_provider **, const char *, const char *, DWORD, DWORD);
+typedef BOOL (__winfnc *acquire_w_fnc)(struct crypt_provider **, const char16_t *, const char16_t *, DWORD, DWORD);
+typedef BOOL (__winfnc *release_fnc)(struct crypt_provider *, DWORD);
+typedef BOOL (__winfnc *random_fnc)(struct crypt_provider *, DWORD, BYTE *);
+typedef BOOL (__winfnc *create_hash_fnc)(struct crypt_provider *, ALG_ID, struct crypt_key *, DWORD, struct crypt_hash **);
+typedef BOOL (__winfnc *hash_data_fnc)(struct crypt_hash *, const BYTE *, DWORD, DWORD);
+typedef BOOL (__winfnc *get_hash_fnc)(struct crypt_hash *, DWORD, BYTE *, DWORD *, DWORD);
+typedef BOOL (__winfnc *destroy_hash_fnc)(struct crypt_hash *);
+typedef DWORD (__winfnc *get_error_fnc)(void);
+
+struct capi_api {
+    acquire_a_fnc acquire_a;
+    acquire_w_fnc acquire_w;
+    release_fnc release;
+    random_fnc random;
+    create_hash_fnc create_hash;
+    hash_data_fnc hash_data;
+    get_hash_fnc get_hash;
+    destroy_hash_fnc destroy_hash;
+    get_error_fnc get_error;
+};
+
+static void *resolved_symbol(void *resolver, void *library, const char *name) {
+    void *(*resolve)(const char *);
+    memcpy(&resolve, &resolver, sizeof(resolve));
+    void *resolved = resolve(name);
+    if(!resolved) fprintf(stderr, "unresolved Windows API export: %s\n", name);
+    assert(resolved != NULL);
+    assert(resolved == dlsym(library, name));
+    return resolved;
+}
+
+#define LOAD_MEMBER(api, member, type, export_name, resolver, library) do { \
+    void *symbol = resolved_symbol((resolver), (library), (export_name)); \
+    (api)->member = (type) symbol; \
+} while(0)
+
+static void check_capi(const struct capi_api *api, int wrapped_random) {
+    struct crypt_provider *prov = (struct crypt_provider *) (uintptr_t) 1;
+    const char16_t unknown_provider[] = { 'N', 0xe9, 0 };
+
+    assert(!api->acquire_a(&prov, NULL, NULL, PROV_DSS, 0));
+    assert(prov == NULL);
+    assert(api->get_error() == NTE_BAD_PROV_TYPE);
+    assert(!api->acquire_w(&prov, u"SYNA", unknown_provider, PROV_RSA_FULL, 0));
+    assert(prov == NULL);
+    assert(api->get_error() == NTE_BAD_PROVIDER);
+    assert(!api->acquire_w(&prov, u"SYNA", NULL, PROV_RSA_FULL, CRYPT_NEWKEYSET));
+    assert(prov == NULL);
+    assert(api->get_error() == NTE_BAD_FLAGS);
+    assert(!api->acquire_w(NULL, NULL, NULL, PROV_RSA_FULL, 0));
+    assert(api->get_error() == ERROR_INVALID_PARAMETER);
+
+    //Exact adapter path: SYNA + default PROV_RSA_FULL + SHA-1 of 32 bytes.
+    assert(api->acquire_w(&prov, u"SYNA", NULL, PROV_RSA_FULL, 0));
+    assert(prov != NULL);
+    struct crypt_hash *hash = NULL;
+    assert(api->create_hash(prov, CALG_SHA1, NULL, 0, &hash));
+    assert(hash != NULL);
+    BYTE input[32] = {0};
+    assert(api->hash_data(hash, input, sizeof(input), 0));
+    DWORD digest_len = 0;
+    assert(api->get_hash(hash, HP_HASHVAL, NULL, &digest_len, 0));
+    assert(digest_len == 20);
+    BYTE digest[20];
+    static const BYTE expected_digest[20] = {
+        0xde, 0x8a, 0x84, 0x7b, 0xff, 0x8c, 0x34, 0x3d, 0x69, 0xb8,
+        0x53, 0xa2, 0x15, 0xe6, 0xee, 0x77, 0x5e, 0xf2, 0xef, 0x96
+    };
+    assert(api->get_hash(hash, HP_HASHVAL, digest, &digest_len, 0));
+    assert(digest_len == sizeof(digest));
+    assert(memcmp(digest, expected_digest, sizeof(digest)) == 0);
+    assert(api->destroy_hash(hash));
+    assert(api->release(prov, 0));
+
+    assert(!api->release(NULL, 0));
+    assert(api->get_error() == NTE_INVALID_HANDLE);
+    assert(api->acquire_w(&prov, NULL, NULL, PROV_RSA_FULL, CRYPT_VERIFYCONTEXT));
+    assert(!api->release(prov, CRYPT_DELETEKEYSET));
+    assert(api->get_error() == NTE_BAD_FLAGS);
+    assert(api->release(prov, 0));
+
+    //Sensor path and independent provider lifetimes.
+    struct crypt_provider *aes_prov = NULL;
+    assert(api->acquire_a(&aes_prov, "VFS key container", NULL, PROV_RSA_AES, 0));
+    assert(aes_prov != NULL);
+    assert(api->acquire_w(&prov, u"SYNA", u"Microsoft Enhanced RSA and AES Cryptographic Provider", PROV_RSA_AES, 0));
+    assert(prov != NULL && prov != aes_prov);
+
+    BYTE random_buf[32], canary[16];
+    memset(canary, 0xa5, sizeof(canary));
+    memset(random_buf, 0xa5, sizeof(random_buf));
+    assert(api->random(aes_prov, sizeof(random_buf), random_buf));
+    if(wrapped_random) {
+        for(size_t i = 0; i < sizeof(random_buf); i++) assert(random_buf[i] == (BYTE) i);
+    }
+    for(size_t i = 0; i < sizeof(canary); i++) assert(canary[i] == 0xa5);
+
+    int calls_before = random_calls;
+    assert(api->random(aes_prov, 0, NULL));
+    if(wrapped_random) assert(random_calls == calls_before);
+    assert(!api->random(aes_prov, 1, NULL));
+    assert(api->get_error() == ERROR_INVALID_PARAMETER);
+    assert(!api->random(NULL, 1, random_buf));
+    assert(api->get_error() == NTE_INVALID_HANDLE);
+
+    if(wrapped_random) {
+        fail_random = 1;
+        assert(!api->random(aes_prov, sizeof(random_buf), random_buf));
+        assert(api->get_error() == NTE_FAIL);
+        fail_random = 0;
+        assert(api->random(aes_prov, sizeof(random_buf), random_buf));
+    }
+
+    assert(api->release(prov, 0));
+    assert(api->release(aes_prov, 0));
+}
+
+static const char *const imported_capi[] = {
+    "CryptAcquireContextA", "CryptAcquireContextW", "CryptReleaseContext",
+    "CryptDestroyKey", "CryptSetKeyParam", "CryptSetHashParam",
+    "CryptGetHashParam", "CryptGenRandom", "CryptImportKey", "CryptEncrypt",
+    "CryptDecrypt", "CryptCreateHash", "CryptHashData", "CryptDestroyHash",
+    "CryptDuplicateHash"
+};
+
+static void check_real_library(const char *path) {
+    void *library = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+    assert(library != NULL);
+    void *resolver = dlsym(library, "resolve_windows_api");
+    assert(resolver != NULL);
+    for(size_t i = 0; i < sizeof(imported_capi) / sizeof(imported_capi[0]); i++) {
+        resolved_symbol(resolver, library, imported_capi[i]);
+    }
+
+    struct capi_api api;
+    LOAD_MEMBER(&api, acquire_a, acquire_a_fnc, "CryptAcquireContextA", resolver, library);
+    LOAD_MEMBER(&api, acquire_w, acquire_w_fnc, "CryptAcquireContextW", resolver, library);
+    LOAD_MEMBER(&api, release, release_fnc, "CryptReleaseContext", resolver, library);
+    LOAD_MEMBER(&api, random, random_fnc, "CryptGenRandom", resolver, library);
+    LOAD_MEMBER(&api, create_hash, create_hash_fnc, "CryptCreateHash", resolver, library);
+    LOAD_MEMBER(&api, hash_data, hash_data_fnc, "CryptHashData", resolver, library);
+    LOAD_MEMBER(&api, get_hash, get_hash_fnc, "CryptGetHashParam", resolver, library);
+    LOAD_MEMBER(&api, destroy_hash, destroy_hash_fnc, "CryptDestroyHash", resolver, library);
+    void *symbol = resolved_symbol(resolver, library, "GetLastError");
+    api.get_error = (get_error_fnc) symbol;
+
+    check_capi(&api, 0);
+    assert(dlclose(library) == 0);
+    puts("real libtudor: imported CAPI resolution, SHA-1, Unicode, lifecycle, and RNG passed");
+}
+
+int main(int argc, char **argv) {
+    _Static_assert(sizeof(DWORD) == 4, "CAPI DWORD ABI");
+    _Static_assert(sizeof(BOOL) == 4, "CAPI BOOL ABI");
+    _Static_assert(sizeof(char16_t) == 2, "CAPI wide string ABI");
+    _Static_assert(sizeof(struct crypt_provider *) == sizeof(uintptr_t), "CAPI handle ABI");
+
+    struct capi_api api = {
+        .acquire_a = CryptAcquireContextA,
+        .acquire_w = CryptAcquireContextW,
+        .release = CryptReleaseContext,
+        .random = CryptGenRandom,
+        .create_hash = CryptCreateHash,
+        .hash_data = CryptHashData,
+        .get_hash = CryptGetHashParam,
+        .destroy_hash = CryptDestroyHash,
+        .get_error = test_get_last_error
+    };
+    check_capi(&api, 1);
+    puts("standalone CAPI: deterministic SHA-1/RNG and error paths passed");
+
+    if(argc == 2) check_real_library(argv[1]);
+    return 0;
+}
diff --git a/tests/cli_retry_test.c b/tests/cli_retry_test.c
new file mode 100644
index 0000000..1b31cd1
--- /dev/null
+++ b/tests/cli_retry_test.c
@@ -0,0 +1,44 @@
+/*
+ * Offline checks of the CLI's bounded capture-retry policy and of the verify
+ * finger selection helper.
+ *
+ * The CLI must retry a rejected capture (bad placement) but stop after a fixed
+ * number of rejections instead of spinning forever when the engine rejects every
+ * sample (e.g. no usable enrolled template).
+ */
+#include <assert.h>
+#include <stdio.h>
+#include "cli.h"
+
+int main(int argc, char **argv) {
+    (void) argc; (void) argv;
+
+    assert(CLI_MAX_CAPTURE_RETRIES > 0);
+
+    int retries = 0, allowed = 0;
+    while(cli_capture_retry_pending(&retries)) {
+        allowed++;
+        assert(allowed <= CLI_MAX_CAPTURE_RETRIES);
+    }
+
+    assert(allowed == CLI_MAX_CAPTURE_RETRIES);
+    assert(retries == CLI_MAX_CAPTURE_RETRIES);
+
+    //Verify finger selection: 0 keeps the any-finger behaviour, 1-10 map to the
+    //corresponding finger, anything out of range falls back to any.
+    assert(cli_parse_finger(0) == TUDOR_FINGER_ANY);
+    assert(cli_parse_finger(1) == TUDOR_FINGER_RH_THUMB);
+    assert(cli_parse_finger(2) == TUDOR_FINGER_RH_INDEX_FINGER);
+    assert(cli_parse_finger(5) == TUDOR_FINGER_RH_LITTLE_FINGER);
+    assert(cli_parse_finger(6) == TUDOR_FINGER_LH_THUMB);
+    assert(cli_parse_finger(10) == TUDOR_FINGER_LH_LITTLE_FINGER);
+    assert(cli_parse_finger(11) == TUDOR_FINGER_ANY);
+    assert(cli_parse_finger(0xffffffff) == TUDOR_FINGER_ANY);
+
+    //Once the budget is spent the helper keeps refusing and doesn't count further
+    assert(cli_capture_retry_pending(&retries) == false);
+    assert(retries == CLI_MAX_CAPTURE_RETRIES);
+
+    puts("[TEST] CLI capture retry bound checks passed");
+    return 0;
+}
diff --git a/tests/commit_storage_test.c b/tests/commit_storage_test.c
new file mode 100644
index 0000000..ead7f1d
--- /dev/null
+++ b/tests/commit_storage_test.c
@@ -0,0 +1,259 @@
+/*
+ * Offline check of the WinBio enroll-commit <-> storage-adapter contract.
+ *
+ * Loads the real vendor adapter DLL (embedded in libtudor) and drives
+ * WINBIO_ENGINE_INTERFACE::CommitEnrollment with synthetic pipelines for both
+ * storage backends libtudor supports:
+ *
+ *  - host adapter: proves the record the engine hands over is stored and readable
+ *    (identity, subfactor, payload) instead of being rejected.
+ *  - vendor adapter: proves the engine's commit reaches the sensor record write
+ *    (IOCTL 0x442018) with the identity and the payload attached.
+ *
+ * No USB device is opened: the pipeline's sensor handle is a test double that
+ * records ioctls and completes them, and the engine never asks for a pending
+ * template blob (EngineContext+0x120), so it stays off the real hardware path.
+ */
+#include <assert.h>
+#include <pthread.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <tudor/tudor.h>
+#include "tudor/internal.h"
+
+#define ENGINE_CONTEXT_SIZE 0x400
+#define ENGINE_CTX_ENROLL_ACTIVE_OFF 0x5c
+#define ENGINE_CTX_PENDING_TEMPLATE_OFF 0x120
+#define ENGINE_CTX_LOCK_OFF 0x168
+#define IOCTL_STORAGE_ADD_RECORD 0x442018
+
+extern void *resolve_windows_api(const char *name);
+typedef BOOL (__winfnc *init_cs_fnc)(void *sect, DWORD spin_count, DWORD flags);
+
+struct ioctl_log {
+    ULONG code;
+    size_t in_size;
+    uint8_t in[128];
+};
+
+static struct {
+    int count;
+    struct ioctl_log entries[16];
+} ioctls;
+
+static NTSTATUS fake_devctrl(void *ctx, OVERLAPPED *ovlp, ULONG code, const void *in_buf, size_t in_size, void *out_buf, size_t out_size, void **op_ctx) {
+    (void) ctx; (void) op_ctx;
+
+    if(ioctls.count < (int) (sizeof(ioctls.entries) / sizeof(ioctls.entries[0]))) {
+        struct ioctl_log *entry = &ioctls.entries[ioctls.count++];
+        entry->code = code;
+        entry->in_size = in_size;
+        if(in_buf) memcpy(entry->in, in_buf, in_size < sizeof(entry->in) ? in_size : sizeof(entry->in));
+    }
+
+    if(out_buf && out_size) memset(out_buf, 0, out_size);
+    winio_complete_overlapped(ovlp, STATUS_SUCCESS, out_size >= 8 ? 8 : out_size);
+    return STATUS_SUCCESS;
+}
+
+static NTSTATUS fake_cancel(void *ctx, OVERLAPPED *ovlp, void *op_ctx) { (void) ctx; (void) ovlp; (void) op_ctx; return STATUS_SUCCESS; }
+static void fake_cleanup(void *ctx, OVERLAPPED *ovlp, void *op_ctx) { (void) ctx; (void) ovlp; (void) op_ctx; }
+
+static uint8_t *make_engine_context(void) {
+    uint8_t *ctx = calloc(1, ENGINE_CONTEXT_SIZE);
+    assert(ctx);
+
+    //The engine takes this lock around every pipeline operation
+    init_cs_fnc init_cs = (init_cs_fnc) resolve_windows_api("InitializeCriticalSectionEx");
+    assert(init_cs);
+    assert(init_cs(ctx + ENGINE_CTX_LOCK_OFF, 0, 0));
+
+    ctx[ENGINE_CTX_ENROLL_ACTIVE_OFF] = 1;
+    //Leave the pending template blob NULL so the engine never calls DeviceIoControl
+    //for a template commit and stays on the storage path we are testing
+    assert(*(void**) (ctx + ENGINE_CTX_PENDING_TEMPLATE_OFF) == NULL);
+    return ctx;
+}
+
+static WINBIO_PIPELINE make_pipeline(struct tudor_device *device, WINBIO_STORAGE_INTERFACE *storage, bool sensor_storage) {
+    WINBIO_PIPELINE pipeline = {0};
+    pipeline.SensorInterface = tudor_sensor_adapter;
+    pipeline.EngineInterface = tudor_engine_adapter;
+    pipeline.StorageInterface = storage;
+    pipeline.SensorHandle = winio_create_file(device, true, NULL, NULL, fake_devctrl, fake_cancel, fake_cleanup, NULL);
+    pipeline.EngineHandle = INVALID_HANDLE_VALUE;
+    pipeline.StorageHandle = INVALID_HANDLE_VALUE;
+    pipeline.EngineContext = make_engine_context();
+    //The vendor adapter allocates its own context and requires NULL here
+    pipeline.StorageContext = sensor_storage ? NULL : device;
+    assert(pipeline.SensorHandle);
+    return pipeline;
+}
+
+static void teardown_pipeline(WINBIO_PIPELINE *pipeline) {
+    winhandle_destroy(pipeline->SensorHandle);
+    free(pipeline->EngineContext);
+}
+
+static WINBIO_IDENTITY make_identity(void) {
+    return (WINBIO_IDENTITY) {
+        .Type = WINBIO_ID_TYPE_GUID,
+        .TemplateGuid = { .PartA = 0x00000001, .PartB = 0x2222, .PartC = 0x3333, .PartD = 0x4444, .PartE = 0x555566667777 }
+    };
+}
+
+static void free_host_records(struct tudor_device *device) {
+    while(device->records_head) {
+        struct tudor_record *rec = device->records_head;
+        device->records_head = rec->next;
+        free(rec->data);
+        free(rec->payload);
+        free(rec->index_vector);
+        free(rec->identity);
+        free(rec);
+    }
+    device->result_records_head = device->result_records_cursor = NULL;
+}
+
+static void check_commit_host_storage(UCHAR *payload, SIZE_T payload_size) {
+    struct tudor_device device = {0};
+    assert(pthread_mutex_init(&device.records_lock, NULL) == 0);
+
+    WINBIO_PIPELINE pipeline = make_pipeline(&device, tudor_storage_adapter, false);
+    assert(tudor_storage_adapter->Attach(&pipeline) == ERROR_SUCCESS);
+    assert(tudor_storage_adapter->PipelineInit(&pipeline) == ERROR_SUCCESS);
+
+    WINBIO_IDENTITY identity = make_identity();
+    printf("[TEST] host storage: CommitEnrollment(payload_size=%lu)...\n", (unsigned long) payload_size);
+    HRESULT commit_res = tudor_engine_adapter->CommitEnrollment(&pipeline, &identity, TUDOR_FINGER_RH_INDEX_FINGER, payload, payload_size);
+    printf("[TEST] host storage: CommitEnrollment -> 0x%x\n", commit_res);
+    assert(commit_res == ERROR_SUCCESS);
+
+    //The record the engine asked the storage adapter to persist
+    assert(tudor_storage_adapter->QueryBySubject(&pipeline, &identity, TUDOR_FINGER_RH_INDEX_FINGER) == ERROR_SUCCESS);
+    assert(tudor_storage_adapter->FirstRecord(&pipeline) == ERROR_SUCCESS);
+
+    SIZE_T num_records = 0;
+    assert(tudor_storage_adapter->GetRecordCount(&pipeline, &num_records) == ERROR_SUCCESS);
+    assert(num_records == 1);
+
+    WINBIO_STORAGE_RECORD srec = {0};
+    assert(tudor_storage_adapter->GetCurrentRecord(&pipeline, &srec) == ERROR_SUCCESS);
+    printf("[TEST] host storage: subfactor=%u template=%lu payload=%lu\n", (unsigned) srec.SubFactor,
+        (unsigned long) srec.TemplateBlobSize, (unsigned long) srec.PayloadBlobSize);
+    assert(srec.SubFactor == TUDOR_FINGER_RH_INDEX_FINGER);
+    assert(srec.PayloadBlobSize == payload_size);
+    if(payload_size) assert(srec.PayloadBlob && memcmp(srec.PayloadBlob, payload, payload_size) == 0);
+
+    teardown_pipeline(&pipeline);
+    free_host_records(&device);
+    pthread_mutex_destroy(&device.records_lock);
+}
+
+static void check_commit_vendor_storage(UCHAR *payload, SIZE_T payload_size) {
+    struct tudor_device device = {0};
+    assert(pthread_mutex_init(&device.records_lock, NULL) == 0);
+
+    WINBIO_PIPELINE pipeline = make_pipeline(&device, tudor_vendor_storage_adapter, true);
+    memset(&ioctls, 0, sizeof(ioctls));
+
+    assert(tudor_vendor_storage_adapter->Attach(&pipeline) == ERROR_SUCCESS);
+    assert(tudor_vendor_storage_adapter->PipelineInit(&pipeline) == ERROR_SUCCESS);
+    assert(tudor_vendor_storage_adapter->Activate(&pipeline) == ERROR_SUCCESS);
+    const GUID *db_guid = (const GUID*) ((const uint8_t*) tudor_adapter_dll->image.base_addr + 0x1e410);
+    const char16_t *empty = u"";
+    assert(tudor_vendor_storage_adapter->OpenDatabase(&pipeline, (GUID*) db_guid, empty, empty) == ERROR_SUCCESS);
+
+    WINBIO_IDENTITY identity = make_identity();
+    printf("[TEST] vendor storage: CommitEnrollment(payload_size=%lu)...\n", (unsigned long) payload_size);
+    HRESULT commit_res = tudor_engine_adapter->CommitEnrollment(&pipeline, &identity, TUDOR_FINGER_RH_INDEX_FINGER, payload, payload_size);
+    printf("[TEST] vendor storage: CommitEnrollment -> 0x%x (ioctls=%d)\n", commit_res, ioctls.count);
+    assert(commit_res == ERROR_SUCCESS);
+
+    //The engine's storage write must reach the device as a record ioctl
+    struct ioctl_log *add = NULL;
+    for(int i = 0; i < ioctls.count; i++) {
+        if(ioctls.entries[i].code == IOCTL_STORAGE_ADD_RECORD) add = &ioctls.entries[i];
+    }
+    assert(add);
+    assert(add->in[0] == TUDOR_FINGER_RH_INDEX_FINGER);
+    assert(memcmp(add->in + 4, &identity.TemplateGuid, sizeof(GUID)) == 0);
+    bool payload_seen = payload_size == 0;
+    for(size_t i = 0; !payload_seen && i + payload_size <= add->in_size && i + payload_size <= sizeof(add->in); i++) {
+        if(memcmp(add->in + i, payload, payload_size) == 0) payload_seen = true;
+    }
+    assert(payload_seen);
+    printf("[TEST] vendor storage: record ioctl present (in_size=%lu, payload in record=%s)\n",
+        (unsigned long) add->in_size, payload_seen ? "yes" : "no");
+
+    //The query path against the test double must not invent records
+    assert(tudor_vendor_storage_adapter->QueryBySubject(&pipeline, &identity, TUDOR_FINGER_RH_INDEX_FINGER) == WINBIO_E_DATABASE_NO_RESULTS);
+
+    assert(tudor_vendor_storage_adapter->CloseDatabase(&pipeline) == ERROR_SUCCESS);
+    assert(tudor_vendor_storage_adapter->Deactivate(&pipeline) == ERROR_SUCCESS);
+    assert(tudor_vendor_storage_adapter->PipelineCleanup(&pipeline) == ERROR_SUCCESS);
+    assert(tudor_vendor_storage_adapter->Detach(&pipeline) == ERROR_SUCCESS);
+
+    teardown_pipeline(&pipeline);
+    pthread_mutex_destroy(&device.records_lock);
+}
+
+static void check_enrollment_hash_failure_is_reported(void) {
+    struct tudor_device device = {0};
+    assert(pthread_mutex_init(&device.records_lock, NULL) == 0);
+
+    WINBIO_PIPELINE pipeline = make_pipeline(&device, tudor_vendor_storage_adapter, true);
+    assert(tudor_vendor_storage_adapter->Attach(&pipeline) == ERROR_SUCCESS);
+    assert(tudor_vendor_storage_adapter->PipelineInit(&pipeline) == ERROR_SUCCESS);
+    assert(tudor_vendor_storage_adapter->Activate(&pipeline) == ERROR_SUCCESS);
+    const GUID *db_guid = (const GUID*) ((const uint8_t*) tudor_adapter_dll->image.base_addr + 0x1e410);
+    const char16_t *empty = u"";
+    assert(tudor_vendor_storage_adapter->OpenDatabase(&pipeline, (GUID*) db_guid, empty, empty) == ERROR_SUCCESS);
+
+    //A pipeline without pending enrollment data must report a failure, not a bogus hash
+    UCHAR *hash = (UCHAR*) 0x1;
+    SIZE_T hash_size = 0xdead;
+    HRESULT hres = tudor_engine_adapter->GetEnrollmentHash(&pipeline, &hash, &hash_size);
+    printf("[TEST] GetEnrollmentHash without enrollment data -> 0x%x\n", hres);
+    assert(hres != ERROR_SUCCESS);
+
+    //...and committing without a payload still has to work (the fallback path)
+    WINBIO_IDENTITY identity = make_identity();
+    assert(tudor_engine_adapter->CommitEnrollment(&pipeline, &identity, TUDOR_FINGER_RH_INDEX_FINGER, NULL, 0) == ERROR_SUCCESS);
+
+    assert(tudor_vendor_storage_adapter->CloseDatabase(&pipeline) == ERROR_SUCCESS);
+    assert(tudor_vendor_storage_adapter->Deactivate(&pipeline) == ERROR_SUCCESS);
+    assert(tudor_vendor_storage_adapter->PipelineCleanup(&pipeline) == ERROR_SUCCESS);
+    assert(tudor_vendor_storage_adapter->Detach(&pipeline) == ERROR_SUCCESS);
+
+    teardown_pipeline(&pipeline);
+    pthread_mutex_destroy(&device.records_lock);
+}
+
+int main(int argc, char **argv) {
+    (void) argc; (void) argv;
+
+    setvbuf(stdout, NULL, _IONBF, 0);
+    LOG_LEVEL = LOG_ERROR;
+    tudor_log_traces = false;
+
+    assert(tudor_init());
+    assert(tudor_engine_adapter);
+    assert(tudor_storage_adapter);
+    assert(tudor_vendor_storage_adapter);
+
+    UCHAR payload[32];
+    memset(payload, 0xa5, sizeof(payload));
+
+    check_commit_host_storage(NULL, 0);
+    check_commit_host_storage(payload, sizeof(payload));
+    check_commit_vendor_storage(NULL, 0);
+    check_commit_vendor_storage(payload, sizeof(payload));
+    check_enrollment_hash_failure_is_reported();
+
+    assert(tudor_shutdown());
+    puts("[TEST] all commit/storage contract checks passed");
+    return 0;
+}
diff --git a/tests/getlocaltime_test.c b/tests/getlocaltime_test.c
new file mode 100644
index 0000000..ee836b2
--- /dev/null
+++ b/tests/getlocaltime_test.c
@@ -0,0 +1,102 @@
+#include <assert.h>
+#include <dlfcn.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <string.h>
+#include <sys/time.h>
+#include <sys/syscall.h>
+#include <unistd.h>
+#include <time.h>
+#include "winapi/internal.h"
+
+typedef struct {
+    WORD wYear, wMonth, wDayOfWeek, wDay;
+    WORD wHour, wMinute, wSecond, wMilliseconds;
+} SYSTEMTIME;
+
+typedef void (__winfnc *get_local_time_fnc)(SYSTEMTIME *);
+
+__winfnc void GetLocalTime(SYSTEMTIME *outTime);
+
+//Unused by these tests, but required by time.c and its constructor registrations.
+void __register_windows_api(struct __winapi_descr *descr) { (void) descr; }
+void winerr_set_errno() {}
+pthread_mutex_t LOG_LOCK = PTHREAD_MUTEX_INITIALIZER;
+enum log_level LOG_LEVEL = LOG_ERROR;
+
+static struct timeval fixedTime = { .tv_sec = 1704069004, .tv_usec = 987654 };
+
+int __wrap_gettimeofday(struct timeval *time, void *timezone) {
+    (void) timezone;
+    *time = fixedTime;
+    return 0;
+}
+
+static void check_fields(SYSTEMTIME *actual, const WORD expected[8]) {
+    assert(sizeof(SYSTEMTIME) == 16);
+    assert(memcmp(actual, expected, sizeof(SYSTEMTIME)) == 0);
+}
+
+static void expected_from_timeval(SYSTEMTIME *outTime, const struct timeval *time) {
+    struct tm localTime;
+    assert(localtime_r(&time->tv_sec, &localTime) != NULL);
+    outTime->wYear = (WORD) (localTime.tm_year + 1900);
+    outTime->wMonth = (WORD) (localTime.tm_mon + 1);
+    outTime->wDayOfWeek = (WORD) localTime.tm_wday;
+    outTime->wDay = (WORD) localTime.tm_mday;
+    outTime->wHour = (WORD) localTime.tm_hour;
+    outTime->wMinute = (WORD) localTime.tm_min;
+    outTime->wSecond = (WORD) localTime.tm_sec;
+    outTime->wMilliseconds = (WORD) (time->tv_usec / 1000);
+}
+
+static void check_exported_library(const char *path) {
+    void *library = dlopen(path, RTLD_NOW | RTLD_LOCAL);
+    assert(library != NULL);
+    void *symbol = dlsym(library, "GetLocalTime");
+    assert(symbol != NULL);
+    void *(*resolveWindowsApi)(const char *name);
+    void *resolverSymbol = dlsym(library, "resolve_windows_api");
+    assert(resolverSymbol != NULL);
+    memcpy(&resolveWindowsApi, &resolverSymbol, sizeof(resolveWindowsApi));
+    assert(resolveWindowsApi("GetLocalTime") == symbol);
+
+    get_local_time_fnc getLocalTime;
+    memcpy(&getLocalTime, &symbol, sizeof(getLocalTime));
+
+    //2024-01-01 00:30:04.987654 UTC -> 2023-12-31 19:30:04.987 EST.
+    assert(setenv("TZ", "EST5", 1) == 0);
+    tzset();
+    struct timeval before, after;
+    SYSTEMTIME expectedBefore, expectedAfter, actual;
+    assert(syscall(SYS_gettimeofday, &before, NULL) == 0);
+    getLocalTime(&actual);
+    assert(syscall(SYS_gettimeofday, &after, NULL) == 0);
+    expected_from_timeval(&expectedBefore, &before);
+    expected_from_timeval(&expectedAfter, &after);
+    assert(memcmp(&actual, &expectedBefore, sizeof(actual)) == 0 ||
+           memcmp(&actual, &expectedAfter, sizeof(actual)) == 0);
+    assert(dlclose(library) == 0);
+    puts("exported GetLocalTime: EST5 local-time check passed");
+}
+
+int main(int argc, char **argv) {
+    SYSTEMTIME actual;
+
+    assert(setenv("TZ", "UTC0", 1) == 0);
+    tzset();
+    GetLocalTime(&actual);
+    const WORD utc[8] = { 2024, 1, 1, 1, 0, 30, 4, 987 };
+    check_fields(&actual, utc);
+    puts("GetLocalTime: UTC field order, weekday, date, and milliseconds passed");
+
+    assert(setenv("TZ", "EST5", 1) == 0);
+    tzset();
+    GetLocalTime(&actual);
+    const WORD est[8] = { 2023, 12, 0, 31, 19, 30, 4, 987 };
+    check_fields(&actual, est);
+    puts("GetLocalTime: timezone conversion and year boundary passed");
+
+    if(argc == 2) check_exported_library(argv[1]);
+    return 0;
+}
diff --git a/tests/identity_storage_test.c b/tests/identity_storage_test.c
new file mode 100644
index 0000000..4f29c76
--- /dev/null
+++ b/tests/identity_storage_test.c
@@ -0,0 +1,279 @@
+/*
+ * Offline checks for the identity serialization and the WinBio storage record
+ * contract implemented by libtudor's host storage adapter, plus the record
+ * enumeration/deletion helpers the CLI relies on.
+ *
+ * No driver DLL is loaded here: the host adapter is plain C.
+ */
+#include <assert.h>
+#include <pthread.h>
+#include <stddef.h>
+#include <stdint.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include <string.h>
+#include <tudor/tudor.h>
+#include "tudor/internal.h"
+
+static struct tudor_device device;
+static WINBIO_PIPELINE pipeline;
+
+static WINBIO_IDENTITY make_guid_identity(void) {
+    return (WINBIO_IDENTITY) {
+        .Type = WINBIO_ID_TYPE_GUID,
+        .TemplateGuid = {
+            .PartA = 0xdeadbeef,
+            .PartB = 0x1234,
+            .PartC = 0xabcd,
+            .PartD = 0x7788,
+            .PartE = 0x112233445566
+        }
+    };
+}
+
+static WINBIO_STORAGE_RECORD make_record(WINBIO_IDENTITY *identity, UCHAR subfactor, void *template, SIZE_T template_size, void *payload, SIZE_T payload_size) {
+    return (WINBIO_STORAGE_RECORD) {
+        .Identity = identity,
+        .SubFactor = subfactor,
+        .IndexVector = NULL,
+        .IndexElementCount = 0,
+        .TemplateBlob = template,
+        .TemplateBlobSize = template_size,
+        .PayloadBlob = payload,
+        .PayloadBlobSize = payload_size
+    };
+}
+
+static void check_identity_layout(void) {
+    //Values from winbio_types.h: the vendor engine only accepts GUID/SID/SECURE_ID
+    //(2..4) for stored identities, so an off-by-one enum would change the meaning.
+    assert(WINBIO_ID_TYPE_NULL == 0);
+    assert(WINBIO_ID_TYPE_WILDCARD == 1);
+    assert(WINBIO_ID_TYPE_GUID == 2);
+    assert(WINBIO_ID_TYPE_SID == 3);
+    assert(WINBIO_ID_TYPE_SECURE_ID == 4);
+
+    //Wire layout the vendor adapters consume: ULONG Type followed by the value union
+    assert(sizeof(ULONG) == 4);
+    assert(sizeof(GUID) == 16);
+    assert(offsetof(WINBIO_IDENTITY, Type) == 0);
+    assert(offsetof(WINBIO_IDENTITY, TemplateGuid) == 4);
+    assert(offsetof(WINBIO_IDENTITY, AccountSid) == 4);
+    assert(offsetof(WINBIO_IDENTITY, AccountSid.Size) == 4);
+    assert(offsetof(WINBIO_IDENTITY, AccountSid.Data) == 8);
+    assert(sizeof(WINBIO_IDENTITY) == 4 + 4 + 68);
+
+    //A GUID identity must survive a byte copy unchanged
+    WINBIO_IDENTITY identity = make_guid_identity();
+    uint8_t copy[sizeof(GUID)];
+    memcpy(copy, &identity.TemplateGuid, sizeof(copy));
+    assert(memcmp(copy, &identity.TemplateGuid, sizeof(copy)) == 0);
+    assert(identity.TemplateGuid.PartA == 0xdeadbeef);
+    assert(identity.TemplateGuid.PartB == 0x1234);
+    assert(identity.TemplateGuid.PartC == 0xabcd);
+    assert(identity.TemplateGuid.PartD == 0x7788);
+    assert(identity.TemplateGuid.PartE == 0x112233445566);
+}
+
+static void check_record_roundtrip(void) {
+    WINBIO_IDENTITY identity = make_guid_identity();
+    UCHAR template_blob[16], payload_blob[32];
+    for(size_t i = 0; i < sizeof(template_blob); i++) template_blob[i] = (UCHAR) (0x10 + i);
+    for(size_t i = 0; i < sizeof(payload_blob); i++) payload_blob[i] = (UCHAR) (0xa0 + i);
+
+    WINBIO_STORAGE_RECORD srec = make_record(&identity, TUDOR_FINGER_RH_INDEX_FINGER, template_blob, sizeof(template_blob), payload_blob, sizeof(payload_blob));
+    assert(tudor_storage_adapter->AddRecord(&pipeline, &srec) == ERROR_SUCCESS);
+
+    //A duplicate identity/subfactor pair must be refused, not silently overwritten
+    WINBIO_STORAGE_RECORD dup = srec;
+    assert(tudor_storage_adapter->AddRecord(&pipeline, &dup) == WINBIO_E_DUPLICATE_ENROLLMENT);
+
+    //Query by the exact identity returns the stored record, including the payload
+    assert(tudor_storage_adapter->QueryBySubject(&pipeline, &identity, TUDOR_FINGER_RH_INDEX_FINGER) == ERROR_SUCCESS);
+    assert(tudor_storage_adapter->FirstRecord(&pipeline) == ERROR_SUCCESS);
+
+    SIZE_T num_records = 0;
+    assert(tudor_storage_adapter->GetRecordCount(&pipeline, &num_records) == ERROR_SUCCESS);
+    assert(num_records == 1);
+
+    WINBIO_STORAGE_RECORD out = {0};
+    assert(tudor_storage_adapter->GetCurrentRecord(&pipeline, &out) == ERROR_SUCCESS);
+    assert(out.Identity != NULL);
+    assert(out.Identity->Type == WINBIO_ID_TYPE_GUID);
+    assert(memcmp(&out.Identity->TemplateGuid, &identity.TemplateGuid, sizeof(GUID)) == 0);
+    assert(out.SubFactor == TUDOR_FINGER_RH_INDEX_FINGER);
+    assert(out.TemplateBlobSize == sizeof(template_blob));
+    assert(out.TemplateBlob && memcmp(out.TemplateBlob, template_blob, sizeof(template_blob)) == 0);
+    assert(out.PayloadBlobSize == sizeof(payload_blob));
+    assert(out.PayloadBlob && memcmp(out.PayloadBlob, payload_blob, sizeof(payload_blob)) == 0);
+    assert(out.IndexElementCount == 0);
+    assert(tudor_storage_adapter->NextRecord(&pipeline) == WINBIO_E_DATABASE_NO_MORE_RECORDS);
+
+    //A different GUID must not match
+    WINBIO_IDENTITY other = identity;
+    other.TemplateGuid.PartA++;
+    assert(tudor_storage_adapter->QueryBySubject(&pipeline, &other, WINBIO_SUBTYPE_ANY) == WINBIO_E_DATABASE_NO_RESULTS);
+}
+
+static void check_enumeration_helpers(void) {
+    struct tudor_stored_record records[4];
+
+    int count = tudor_storage_get_records(&device, records, 4);
+    assert(count == 1);
+    assert(records[0].guid.PartA == 0xdeadbeef);
+    assert(records[0].finger == TUDOR_FINGER_RH_INDEX_FINGER);
+    assert(records[0].template_size == 16);
+    assert(records[0].payload_size == 32);
+
+    //Filtered deletion of a non-matching identity must fail cleanly
+    WINBIO_IDENTITY other = make_guid_identity();
+    other.TemplateGuid.PartA++;
+    RECGUID other_guid = *(RECGUID*) &other.TemplateGuid;
+    assert(tudor_storage_delete_records(&device, &other_guid, TUDOR_FINGER_ANY) == false);
+
+    //Matching deletion must succeed and release the record
+    WINBIO_IDENTITY identity = make_guid_identity();
+    RECGUID guid = *(RECGUID*) &identity.TemplateGuid;
+    assert(tudor_storage_delete_records(&device, &guid, TUDOR_FINGER_RH_INDEX_FINGER) == true);
+    assert(device.records_head == NULL);
+    assert(tudor_storage_adapter->QueryBySubject(&pipeline, &identity, WINBIO_SUBTYPE_ANY) == WINBIO_E_DATABASE_NO_RESULTS);
+    assert(tudor_storage_get_records(&device, records, 4) == 0);
+}
+
+static void check_failure_paths(void) {
+    WINBIO_IDENTITY identity = make_guid_identity();
+    UCHAR blob[8] = {0};
+
+    //Wrong identity types are not storable
+    WINBIO_IDENTITY wildcard = { .Type = WINBIO_ID_TYPE_WILDCARD, .Wildcard = 1 };
+    WINBIO_STORAGE_RECORD rec = make_record(&wildcard, 1, blob, sizeof(blob), NULL, 0);
+    assert(tudor_storage_adapter->AddRecord(&pipeline, &rec) == E_INVALIDARG);
+
+    WINBIO_IDENTITY secure = identity;
+    secure.Type = WINBIO_ID_TYPE_SECURE_ID;
+    rec = make_record(&secure, 1, blob, sizeof(blob), NULL, 0);
+    assert(tudor_storage_adapter->AddRecord(&pipeline, &rec) == E_INVALIDARG);
+
+    //Declared sizes without pointers are refused instead of dereferenced
+    rec = make_record(&identity, 1, blob, sizeof(blob), NULL, sizeof(blob));
+    assert(tudor_storage_adapter->AddRecord(&pipeline, &rec) == E_INVALIDARG);
+
+    rec = make_record(&identity, 1, NULL, sizeof(blob), NULL, 0);
+    assert(tudor_storage_adapter->AddRecord(&pipeline, &rec) == E_INVALIDARG);
+
+    rec = make_record(&identity, 1, blob, sizeof(blob), NULL, 0);
+    rec.IndexVector = NULL;
+    rec.IndexElementCount = 2;
+    assert(tudor_storage_adapter->AddRecord(&pipeline, &rec) == E_INVALIDARG);
+
+    //Nothing was stored by the failed attempts
+    assert(device.records_head == NULL);
+    assert(tudor_storage_adapter->QueryBySubject(&pipeline, &identity, WINBIO_SUBTYPE_ANY) == WINBIO_E_DATABASE_NO_RESULTS);
+    assert(tudor_storage_adapter->FirstRecord(&pipeline) == WINBIO_E_DATABASE_NO_RESULTS);
+    assert(tudor_storage_adapter->GetCurrentRecord(&pipeline, &(WINBIO_STORAGE_RECORD){0}) == WINBIO_E_DATABASE_NO_RESULTS);
+    assert(tudor_storage_adapter->NextRecord(&pipeline) == WINBIO_E_DATABASE_NO_RESULTS);
+
+    //Deleting something that isn't there reports the documented error
+    assert(tudor_storage_adapter->DeleteRecord(&pipeline, &identity, 1) == WINBIO_E_DATABASE_NO_SUCH_RECORD);
+}
+
+static void check_zero_size_template(void) {
+    //Match-in-sensor engines commit identity-only records: no template blob at all
+    WINBIO_IDENTITY identity = make_guid_identity();
+    identity.TemplateGuid.PartA = 7;
+    WINBIO_STORAGE_RECORD rec = make_record(&identity, TUDOR_FINGER_LH_THUMB, NULL, 0, NULL, 0);
+    assert(tudor_storage_adapter->AddRecord(&pipeline, &rec) == ERROR_SUCCESS);
+
+    assert(tudor_storage_adapter->QueryBySubject(&pipeline, &identity, TUDOR_FINGER_LH_THUMB) == ERROR_SUCCESS);
+    assert(tudor_storage_adapter->FirstRecord(&pipeline) == ERROR_SUCCESS);
+    WINBIO_STORAGE_RECORD out = {0};
+    assert(tudor_storage_adapter->GetCurrentRecord(&pipeline, &out) == ERROR_SUCCESS);
+    assert(out.TemplateBlob == NULL && out.TemplateBlobSize == 0);
+    assert(out.PayloadBlob == NULL && out.PayloadBlobSize == 0);
+
+    //Wildcard delete removes the record and frees it
+    WINBIO_IDENTITY wildcard = { .Type = WINBIO_ID_TYPE_WILDCARD, .Wildcard = 1 };
+    assert(tudor_storage_adapter->DeleteRecord(&pipeline, &wildcard, WINBIO_SUBTYPE_ANY) == ERROR_SUCCESS);
+    assert(device.records_head == NULL);
+}
+
+static void check_any_subfactor_resolution(void) {
+    //WinBioVerify resolves WINBIO_SUBTYPE_ANY inside the framework, before an engine
+    //adapter sees it: the records for the identity are enumerated and the engine is
+    //called with each concrete subfactor. Handing the wildcard to the vendor engine
+    //makes its on-chip lookup match nothing, so every capture is rejected as a bad one.
+    WINBIO_IDENTITY identity = make_guid_identity();
+    UCHAR blob[8] = {0};
+    WINBIO_STORAGE_RECORD rec = make_record(&identity, TUDOR_FINGER_LH_RING_FINGER, blob, sizeof(blob), NULL, 0);
+    assert(tudor_storage_adapter->AddRecord(&pipeline, &rec) == ERROR_SUCCESS);
+
+    RECGUID guid = *(RECGUID*) &identity.TemplateGuid;
+    assert(tudor_resolve_finger(&device, guid, TUDOR_FINGER_ANY) == TUDOR_FINGER_LH_RING_FINGER);
+
+    //A concrete subfactor is passed through untouched, enrolled or not
+    assert(tudor_resolve_finger(&device, guid, TUDOR_FINGER_RH_INDEX_FINGER) == TUDOR_FINGER_RH_INDEX_FINGER);
+
+    //An identity without records keeps the wildcard; the engine, not the loader, decides
+    WINBIO_IDENTITY unknown = identity;
+    unknown.TemplateGuid.PartA++;
+    RECGUID unknown_guid = *(RECGUID*) &unknown.TemplateGuid;
+    assert(tudor_resolve_finger(&device, unknown_guid, TUDOR_FINGER_ANY) == TUDOR_FINGER_ANY);
+
+    WINBIO_IDENTITY wildcard = { .Type = WINBIO_ID_TYPE_WILDCARD, .Wildcard = 1 };
+    assert(tudor_storage_adapter->DeleteRecord(&pipeline, &wildcard, WINBIO_SUBTYPE_ANY) == ERROR_SUCCESS);
+    assert(device.records_head == NULL);
+}
+
+static void check_identity_helpers_zero_the_union(void) {
+    //The vendor adapters marshal sizeof(WINBIO_IDENTITY) bytes to the driver, including
+    //the SID/secure-id part of the union. Building the identity with a compound literal
+    //leaves that part uninitialized, so stack addresses travel with every commit, query
+    //and verify request and end up in the on-sensor record and its payload tags.
+    RECGUID guid = {
+        .PartA = 0x11223344, .PartB = 0x5566, .PartC = 0x7788,
+        .PartD = 0x99aa, .PartE = 0xbbccddeeff00
+    };
+    WINBIO_IDENTITY ident;
+    memset(&ident, 0xcd, sizeof(ident));
+    ident = tudor_guid_identity(guid);
+    assert(ident.Type == WINBIO_ID_TYPE_GUID);
+    assert(memcmp(&ident.TemplateGuid, &guid, sizeof(GUID)) == 0);
+    for(size_t i = 20; i < sizeof(ident); i++) assert(((const uint8_t*) &ident)[i] == 0);
+
+    WINBIO_IDENTITY wildcard;
+    memset(&wildcard, 0xcd, sizeof(wildcard));
+    wildcard = tudor_wildcard_identity();
+    assert(wildcard.Type == WINBIO_ID_TYPE_WILDCARD);
+    for(size_t i = 4; i < sizeof(wildcard); i++) assert(((const uint8_t*) &wildcard)[i] == 0);
+}
+
+int main(int argc, char **argv) {
+    (void) argc; (void) argv;
+
+    LOG_LEVEL = LOG_ERROR;
+
+    assert(pthread_mutex_init(&device.records_lock, NULL) == 0);
+    memset(&pipeline, 0, sizeof(pipeline));
+    pipeline.StorageInterface = tudor_storage_adapter;
+    pipeline.StorageContext = &device;
+    device.pipeline = &pipeline;
+
+    assert(tudor_storage_adapter->Attach(&pipeline) == ERROR_SUCCESS);
+    assert(tudor_storage_adapter->PipelineInit(&pipeline) == ERROR_SUCCESS);
+
+    check_identity_layout();
+    check_record_roundtrip();
+    check_enumeration_helpers();
+    check_failure_paths();
+    check_zero_size_template();
+    check_any_subfactor_resolution();
+    check_identity_helpers_zero_the_union();
+
+    assert(tudor_storage_adapter->PipelineCleanup(&pipeline) == ERROR_SUCCESS);
+    assert(tudor_storage_adapter->Detach(&pipeline) == ERROR_SUCCESS);
+    assert(device.records_head == NULL);
+    pthread_mutex_destroy(&device.records_lock);
+
+    puts("[TEST] identity/storage contract checks passed");
+    return 0;
+}
