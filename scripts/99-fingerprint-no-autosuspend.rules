# Disable USB autosuspend for Synaptics Prometheus fingerprint reader (06cb:00f0)
# Prevents "Corrupted message received" / "unsupported firmware version" / "Enrollment failed (104)"
ACTION=="add", SUBSYSTEM=="usb", ATTR{idVendor}=="06cb", ATTR{idProduct}=="00f0", TEST=="power/control", ATTR{power/control}="on"
